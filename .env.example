SECRET_KEY=changeme
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# uso local sin docker (manage.py runserver): config.settings.development, sqlite.
# docker compose ignora esta variable y fuerza config.settings.production (ver
# docker-compose.yml), así que solo importa para el arranque local.
DJANGO_SETTINGS_MODULE=config.settings.development

# usadas solo por config.settings.production (docker compose las sobrescribe: POSTGRES_HOST
# pasa a ser el nombre del servicio "db"). en local sin docker no se usan (sqlite).
POSTGRES_DB=clinicas
POSTGRES_USER=clinicas
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
